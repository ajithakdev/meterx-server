{
  "name": "meterx",
  "version": "2026.0.319-MR1.0",
  "private": true,
  "description": "MeterX - Open source internet speed test browser extension",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run build --workspaces --if-present",
    "start": "node packages/server/dist/server.js",
    "dev": "npm run build --workspaces --if-present && node packages/server/dist/server.js",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": ["speed-test", "browser-extension", "network-monitor"],
  "author": "ajithakdev (https://github.com/ajithakdev)",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.5"
  }
}
